# Backend configuration
# Comma-separated pool of at least two provider API keys (assigned key_1, key_2, ...)
LLM_API_KEYS=YOUR_KEY_1,YOUR_KEY_2

# LiteLLM provider/model identifier (e.g. gemini/gemini-2.0-flash, openai/gpt-4o-mini, groq/llama-3.3-70b-versatile)
LLM_MODEL=provider/model-name

# SQLite database URL (Docker Compose mounts a persistent volume at /data)
DATABASE_URL=sqlite:////data/app.db

# Comma-separated CORS allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# Enable X-Simulate-Failure test header on POST /chat
ENABLE_FAILURE_SIMULATION=true

# Enable LiteLLM built-in in-memory response cache
CACHE_ENABLED=true

# Frontend configuration (used at Vite build time)
VITE_API_BASE_URL=http://localhost:8000
